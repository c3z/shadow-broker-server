# Version control
.git

# Local secrets / environment files (keep .env.example in the context)
.env
.env.*
!.env.example

# Node dependencies (client-js, proxy)
**/node_modules
**/npm-debug.log
**/yarn-debug.log
**/yarn-error.log

# Python virtualenv and caches (client-py)
client-py/.venv
**/__pycache__

# Runtime data and logs - embedded SQLite lives in a mounted volume,
# never inside the image
data
proxy/data
proxy/logs
**/*.log

# OS / IDE noise
**/.DS_Store
**/.idea
**/.vscode
**/*.swp
**/*.swo

# Copy to .env and fill in. .env is git-ignored - never commit real values.

# Public domain pointing at this server (A/AAAA record required for Let's Encrypt).
DOMAIN=broker.example.com

# Base64-encoded JSON config consumed by the broker (env SHADOW_BROKER_CONFIG).
# db_url points at the /data volume inside the container.
# Generate it with:
#
#   printf '{"url":"https://%s","secret_key":"%s","auth_token":"%s","db_url":"file:/data/broker.db"}' \
#     "$DOMAIN" "$(openssl rand -hex 16)" "$(openssl rand -hex 32)" | base64 | tr -d '\n'
#
# (deploy/bootstrap.sh does this automatically.)
SHADOW_BROKER_CONFIG=
